InstanceId,Name,State,InstanceType,LaunchTime,PrivateIP,PublicIP,AvailabilityZone,CPUUtilization_Avg,CPUUtilization_Max,NetworkIn_Avg,NetworkIn_Max,NetworkOut_Avg,NetworkOut_Max,DiskReadBytes_Avg,DiskReadBytes_Max,DiskWriteBytes_Avg,DiskWriteBytes_Max,StatusCheckFailed_Avg,StatusCheckFailed_Max
{% for inst in raw_instances | default([]) %}
{% set name_tag = (inst.Tags | default([]) | selectattr('Key', 'equalto', 'Name') | map(attribute='Value') | first) | default('') %}
{% set cpu_match = (cw_metrics_raw.results | default([]) | selectattr('item.0.InstanceId', 'equalto', inst.InstanceId) | selectattr('item.1', 'equalto', 'CPUUtilization') | first | default(none)) if inst.State.Name == 'running' else none %}
{% set netin_match = (cw_metrics_raw.results | default([]) | selectattr('item.0.InstanceId', 'equalto', inst.InstanceId) | selectattr('item.1', 'equalto', 'NetworkIn') | first | default(none)) if inst.State.Name == 'running' else none %}
{% set netout_match = (cw_metrics_raw.results | default([]) | selectattr('item.0.InstanceId', 'equalto', inst.InstanceId) | selectattr('item.1', 'equalto', 'NetworkOut') | first | default(none)) if inst.State.Name == 'running' else none %}
{% set diskr_match = (cw_metrics_raw.results | default([]) | selectattr('item.0.InstanceId', 'equalto', inst.InstanceId) | selectattr('item.1', 'equalto', 'DiskReadBytes') | first | default(none)) if inst.State.Name == 'running' else none %}
{% set diskw_match = (cw_metrics_raw.results | default([]) | selectattr('item.0.InstanceId', 'equalto', inst.InstanceId) | selectattr('item.1', 'equalto', 'DiskWriteBytes') | first | default(none)) if inst.State.Name == 'running' else none %}
{% set status_match = (cw_metrics_raw.results | default([]) | selectattr('item.0.InstanceId', 'equalto', inst.InstanceId) | selectattr('item.1', 'equalto', 'StatusCheckFailed') | first | default(none)) if inst.State.Name == 'running' else none %}
{% set cpu_dp = ((cpu_match.stdout | from_json).Datapoints | default([]))[0] if (cpu_match and cpu_match.stdout is defined and ((cpu_match.stdout | from_json).Datapoints | default([]) | length > 0)) else none %}
{% set netin_dp = ((netin_match.stdout | from_json).Datapoints | default([]))[0] if (netin_match and netin_match.stdout is defined and ((netin_match.stdout | from_json).Datapoints | default([]) | length > 0)) else none %}
{% set netout_dp = ((netout_match.stdout | from_json).Datapoints | default([]))[0] if (netout_match and netout_match.stdout is defined and ((netout_match.stdout | from_json).Datapoints | default([]) | length > 0)) else none %}
{% set diskr_dp = ((diskr_match.stdout | from_json).Datapoints | default([]))[0] if (diskr_match and diskr_match.stdout is defined and ((diskr_match.stdout | from_json).Datapoints | default([]) | length > 0)) else none %}
{% set diskw_dp = ((diskw_match.stdout | from_json).Datapoints | default([]))[0] if (diskw_match and diskw_match.stdout is defined and ((diskw_match.stdout | from_json).Datapoints | default([]) | length > 0)) else none %}
{% set status_dp = ((status_match.stdout | from_json).Datapoints | default([]))[0] if (status_match and status_match.stdout is defined and ((status_match.stdout | from_json).Datapoints | default([]) | length > 0)) else none %}
